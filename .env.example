# Everything here is optional. kerfreel works fully offline with an SRT/VTT file.

# OpenAI-compatible API for transcription (whisper) and optional LLM reranking.
# Works with OpenAI, Groq, a local LiteLLM / vLLM / LocalAI gateway, etc.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
KERFREEL_TRANSCRIBE_MODEL=whisper-1
KERFREEL_LLM_MODEL=gpt-4o-mini

# Local transcription via `pip install faster-whisper` (or openai-whisper).
KERFREEL_WHISPER_MODEL=base
KERFREEL_PYTHON=python3

# Custom ffmpeg/ffprobe binaries (defaults: whatever is on PATH).
KERFREEL_FFMPEG=ffmpeg
KERFREEL_FFPROBE=ffprobe

# Web studio
PORT=5175
HOST=127.0.0.1
KERFREEL_DATA=.kerfreel
